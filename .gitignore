# Terragrunt cache — generated on every run, never commit
.terragrunt-cache/

# Terraform auto-generated files
.terraform/
terraform.tfstate
terraform.tfstate.backup

# .terraform.lock.hcl is intentionally NOT ignored — it pins exact provider
# versions + checksums per environment and must be committed for anyone
# (including a fresh clone) to get reproducible results

# Files Terragrunt generates inside each module before running
backend.tf
provider.tf

# Secrets — never commit
*.tfvars
*.tfvars.json
